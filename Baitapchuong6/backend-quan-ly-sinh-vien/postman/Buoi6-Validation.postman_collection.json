{
  "info": {
    "name": "Buoi6 - Validation Zod & Morgan",
    "_postman_id": "c5-validation-morgan-buoi6",
    "description": "Bộ kịch bản kiểm thử 12 ca bắt buộc cho Validation Middleware (Zod) và Logging (Morgan) - Buổi 06",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "V01. POST SV006 hợp lệ (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('V01 - Status là 201 Created', () => { pm.response.to.have.status(201); });",
              "pm.test('V01 - Dữ liệu sinh viên được tạo thành công', () => {",
              "    const b = pm.response.json();",
              "    pm.expect(b.success).to.eql(true);",
              "    pm.expect(b.data.maSV).to.eql('SV006');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"maSV\": \"SV006\",\n  \"hoTen\": \"Nguyễn Minh An\",\n  \"email\": \"minhan@example.com\",\n  \"maLop\": \"25CT114\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/sinh-vien",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "sinh-vien"]
        }
      }
    },
    {
      "name": "V02. POST thiếu hoTen (400)",
      "event": [
        {
          "listen": "test",
          "script": {
