              "pm.test('V02 - Status là 400 Bad Request', () => { pm.response.to.have.status(400); });",
              "pm.test('V02 - Báo lỗi thiếu họ tên trong errors', () => {",
              "    const b = pm.response.json();",
              "    pm.expect(b.success).to.eql(false);",
              "    pm.expect(b.errors.some(e => e.field === 'hoTen')).to.eql(true);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
