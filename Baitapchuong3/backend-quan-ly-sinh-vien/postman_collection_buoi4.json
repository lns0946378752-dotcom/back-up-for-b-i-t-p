{
  "info": {
    "_postman_id": "c3e98124-7b19-48e2-9bca-8e2b8347f9a1",
    "name": "Backend Sinh Vien - Buoi 4 SQL Server & Sequelize",
    "description": "Bộ sưu tập Postman kiểm thử đầy đủ các chức năng API Quản lý sinh viên kết nối SQL Server và Sequelize ORM (Buổi 4 - Chương 3).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. GET Root URL (Trạng thái server)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": ["{{baseUrl}}"],
          "path": [""]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Server active message\", () => {",
              "    const b = pm.response.json();",
              "    pm.expect(b.success).to.eql(true);",
              "    pm.expect(b.message).to.include(\"Backend quản lý sinh viên đang hoạt động\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02. GET Danh sách sinh viên (Đọc từ DB)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/sinh-vien",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "sinh-vien"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Danh sach dung hop dong\", () => {",
              "    pm.response.to.have.status(200);",
              "    const b = pm.response.json();",
              "    pm.expect(b.success).to.eql(true);",
              "    pm.expect(b.data).to.be.an(\"array\");",
              "    pm.expect(b.data.some(sv => sv.maSV === \"SV001\")).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
