  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "T01. GET Danh sách sinh viên (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('T01 - Status là 200', () => { pm.response.to.have.status(200); });",
              "pm.test('T01 - Data là một mảng', () => {",
              "    const b = pm.response.json();",
              "    pm.expect(b.success).to.eql(true);",
              "    pm.expect(b.data).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/sinh-vien",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "sinh-vien"]
        }
      }
    },
    {
      "name": "T02. POST Thêm sinh viên SV003 hợp lệ (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('T02 - Status là 201 Created', () => { pm.response.to.have.status(201); });",
              "pm.test('T02 - Tạo sinh viên mới thành công', () => {",
              "    const b = pm.response.json();",
              "    pm.expect(b.success).to.eql(true);",
              "    pm.expect(b.data.maSV).to.eql('SV003');",
              "    pm.expect(b.data.hoTen).to.eql('Ngọc Mai');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"maSV\": \"SV003\",\n  \"hoTen\": \"Ngọc Mai\",\n  \"email\": \"ngocmai@example.com\",\n  \"maLop\": \"25CT114\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/sinh-vien",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "sinh-vien"]
        }
      }
    },
